ANTHROPIC_API_KEY=your_key_here
GOOGLE_MAPS_KEY=your_google_maps_api_key_here
# GOOGLE_MAPS_API_KEY also works (accepted as a fallback name) — don't set both.
RESEND_API_KEY=your_resend_api_key_here
SECRET_KEY=change-this-in-production

# Seed admin user — created automatically on first boot if users.json is absent.
# Set these in Railway (or .env locally) to ensure the admin account always exists.
SEED_ADMIN_EMAIL=your-email@example.com
SEED_ADMIN_PASS=change-this-strong-password
SEED_ADMIN_NAME=Your Name

# Rate data: Google Hotels prices through DataForSEO (the only price source).
# Keep these out of logs and the repo; set them in Railway Variables.
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_api_password
# Health check emails when the DataForSEO balance falls under this (USD, default 10)
DATAFORSEO_MIN_BALANCE=10
# Minutes to wait for DataForSEO's standard queue (default 50)
DATAFORSEO_MAX_WAIT_MIN=50
# Pilot: only these cities (comma-separated; empty = all) and at most this many hotels
SCRAPER_CITIES=
SCRAPER_LIMIT=
# Record Google IDs and map positions only, no prices (for scripts/coordinate_audit.py)
SCRAPER_LOOKUP_ONLY=off
# Headless brand-website and Booking.com steps for hotels DataForSEO has no price for (off unless "on")
SCRAPER_BROWSER_STEPS=off

# Alerts: the 09:00 data health check emails this address (default SEED_ADMIN_EMAIL; "off" stops it)
ALERT_EMAIL=
# Persistent volume path on Railway (default: the app folder)
DATA_DIR=
